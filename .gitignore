# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
# server 包内 SPA 拷贝（prepack 时由 scripts/copy-client-dist.mjs 生成，随 tarball 携带——gitignore 不影响 pack）
client-dist/

# logs
*.log
logs/

# os
.DS_Store

# env
.env
.env.*

# editor
.vscode/
.idea/

# coverage
coverage/

# runtime data（运行时生成的项目数据文件，冒烟/开发会产生，不入库）
*.db
*.db-shm
*.db-wal
outline.json
project.json

# pack 产物与发布备份（打包安装测试 / pnpm pack 产生）
*.tgz
.package.json.publish-backup

# 桌面版打包产物（pnpm deploy 目录与 electron-builder 输出）
packages/desktop/.deploy/
packages/desktop/release/

# 测试项目目录：整体不入库（AGENTS.md 约定）——创作根偏好 .ai-editor/（debug 开关 / lastProject）
# 同样忽略；调试开关写法见 README「快速开始」，本地自行创建
test-project/*
test-project/references/*

packages/server/books

# 创作根运行时状态（服务器以某目录为创作根时会写 .ai-editor/config.json；packages/server 下
# 启动 dev 服务即会在包目录建一份 —— 任何位置的 .ai-editor/ 都不入库）
.ai-editor/

test
