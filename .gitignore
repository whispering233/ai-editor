# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
# server 包内 SPA 拷贝（prepack 时由 scripts/copy-client-dist.mjs 生成，随 tarball 携带——gitignore 不影响 pack）
client-dist/

# logs
*.log
logs/

# os
.DS_Store

# env
.env
.env.*

# editor
.vscode/
.idea/

# coverage
coverage/

# runtime data（运行时生成的项目数据文件，冒烟/开发会产生，不入库）
*.db
*.db-shm
*.db-wal
outline.json
project.json

# pack 产物与发布备份（打包安装测试 / pnpm pack 产生）
*.tgz
.package.json.publish-backup

# 测试项目目录：运行时数据不入库（AGENTS.md 约定）；例外放行调试配置示例
# test-project/.ai-editor/config.json（AGENTS.md 契约的默认示例，随仓库分发）
test-project/*
!test-project/.ai-editor/
!test-project/.ai-editor/config.json