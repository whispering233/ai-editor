{
  "name": "@ai-editor/agent",
  "version": "0.1.0",
  "description": "AI 对话循环：会话管理 / 上下文组装 / 工具调度",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "node ../../scripts/prepare-package-for-publish.mjs",
    "postpack": "node ../../scripts/restore-package-json.mjs"
  },
  "dependencies": {
    "@ai-editor/llm": "workspace:*",
    "@ai-editor/shared": "workspace:*",
    "@ai-editor/tools": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
