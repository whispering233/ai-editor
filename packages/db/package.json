{
  "name": "@whispering233/ai-editor-db",
  "version": "0.0.21",
  "license": "MIT",
  "description": "数据库层：better-sqlite3 连接 / 建表 / 查询",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "node ../../scripts/prepare-package-for-publish.mjs",
    "postpack": "node ../../scripts/restore-package-json.mjs"
  },
  "dependencies": {
    "@whispering233/ai-editor-shared": "workspace:*",
    "better-sqlite3": "^13.0.0",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whispering233/ai-editor"
  }
}
