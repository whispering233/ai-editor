{
  "name": "@whispering233/ai-editor-tools",
  "version": "0.0.4",
  "description": "AI 工具目录：工具定义 + 执行器",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "node ../../scripts/prepare-package-for-publish.mjs",
    "postpack": "node ../../scripts/restore-package-json.mjs"
  },
  "dependencies": {
    "@whispering233/ai-editor-db": "workspace:*",
    "@whispering233/ai-editor-shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "zod": "^4.0.0"
  }
}
