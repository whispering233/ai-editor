{
  "name": "@ai-editor/server",
  "version": "0.1.0",
  "description": "Hono API 服务端（单进程：API + SPA 静态托管，决策 8）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-editor": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "client-dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "node ../../scripts/copy-client-dist.mjs && node ../../scripts/prepare-package-for-publish.mjs",
    "postpack": "node ../../scripts/restore-package-json.mjs"
  },
  "dependencies": {
    "@ai-editor/agent": "workspace:*",
    "@ai-editor/db": "workspace:*",
    "@ai-editor/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "hono": "^4.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}
