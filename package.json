{
  "name": "ai-editor",
  "version": "0.0.11",
  "license": "MIT",
  "private": true,
  "description": "AI 小说创作编辑器（monorepo 根）",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test",
    "pack:test": "node scripts/pack-test-install.mjs",
    "start:test": "node scripts/start-test-install.mjs",
    "test:packed": "pnpm pack:test && pnpm start:test",
    "release:version": "node scripts/sync-version.mjs",
    "start:test-project": "pnpm -r build && node packages/server/dist/index.js test-project"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
